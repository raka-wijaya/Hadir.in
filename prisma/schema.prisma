// Prisma Schema for SiPresma (MySQL Database)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPERADMIN
  ADMIN_MAGANG
  ADMIN_OS
  ANAK_MAGANG
  KARYAWAN_OS
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  HADIR
  IZIN
  SAKIT
  ALPA
}

enum StatusMasuk {
  TEPAT_WAKTU
  TERLAMBAT
}

enum StatusPulang {
  TEPAT_WAKTU
  PULANG_CEPAT
}

enum PendaftarStatus {
  pending
  lolos
  tidak_lolos
}

enum LeaveType {
  SAKIT
  KEPERLUAN_PRIBADI
  LAINNYA
}

enum LeaveStatus {
  Pending
  Disetujui
  Ditolak
}

enum JobdeskStatus {
  Belum_Mulai @map("Belum Mulai")
  Berjalan
  Selesai
}

model User {
  id             String         @id @default(uuid())
  username       String         @unique
  nama           String?
  name           String?
  email          String         @unique
  password       String         @default("admin123")
  no_hp          String?
  phone          String?
  role           Role           @default(ANAK_MAGANG)
  status         UserStatus     @default(ACTIVE)
  sekolah_kampus String?
  institution    String?
  unit_kerja     String?
  studyProgram   String?
  bagian         String?
  periode_mulai  String?
  periode_selesai String?
  startDate      String?
  endDate        String?
  identityNumber String?
  avatar         String?        @db.Text
  supervisor     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  jobDesks       JobDesk[]

  @@map("users")
}

model Attendance {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tanggal         String           @map("attendance_date") // YYYY-MM-DD
  jamMasuk        String?          @map("check_in")        // HH:mm:ss
  jamPulang       String?          @map("check_out")       // HH:mm:ss
  fotoMasuk       String?          @map("check_in_photo")  @db.LongText
  fotoPulang      String?          @map("check_out_photo") @db.LongText
  statusMasuk     StatusMasuk?     @map("status_masuk")
  statusPulang    StatusPulang?    @map("status_pulang")
  status          AttendanceStatus @default(HADIR)
  menitTerlambat  Int              @default(0) @map("late_minutes")
  keteranganIzin  String?          @map("notes")           @db.Text
  dokumenIzin     String?          @map("attachment")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, tanggal], name: "user_daily_attendance")
  @@map("absensi")
}

model LeaveRequest {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        LeaveType
  startDate   String
  endDate     String
  reason      String      @db.Text
  attachment  String?
  status      LeaveStatus @default(Pending)
  approvedBy  String?
  approvedAt  DateTime?
  adminNote   String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("leave_requests")
}

model Izin {
  id              BigInt   @id @default(autoincrement())
  absensi_id      BigInt?  @map("absensi_id")
  user_id         BigInt   @map("user_id")
  jenis           String   @db.VarChar(100)
  tanggal_mulai   DateTime @db.Date @map("tanggal_mulai")
  tanggal_selesai DateTime @db.Date @map("tanggal_selesai")
  alasan          String   @db.Text
  attachment      String?  @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("izin")
}

model Pendaftar {
  id              String          @id @default(uuid())
  kodePendaftaran String          @unique @map("kode_pendaftaran")
  nama            String
  email           String
  noHp            String          @map("no_hp")
  sekolahKampus   String          @map("sekolah_kampus")
  jurusan         String
  alamat          String          @db.Text
  bagian          String
  periodeMulai    String?         @map("periode_mulai")
  periodeSelesai  String?         @map("periode_selesai")
  status          PendaftarStatus @default(pending)
  catatanAdmin    String?         @map("catatan_admin") @db.Text
  fileCv          String?         @map("file_cv")
  portfolioFile   String?         @map("portfolio_file")
  tanggalDaftar   DateTime        @default(now()) @map("tanggal_daftar")
  updatedAt       DateTime        @updatedAt

  @@map("pendaftar")
}

model JobDesk {
  id          String        @id @default(uuid())
  internId    String
  intern      User          @relation(fields: [internId], references: [id], onDelete: Cascade)
  title       String
  description String        @db.Text
  status      JobdeskStatus @default(Belum_Mulai)
  dueDate     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("job_desks")
}

model SystemSetting {
  id                        Int      @id @default(1)
  systemName                String   @default("SiPresma")
  timezone                  String   @default("Asia/Jakarta")
  jamMasukStandar           String   @default("07:30") @map("check_in_time")
  jamPulangStandar          String   @default("16:00") @map("check_out_time")
  jamPulangJumat            String   @default("14:00")
  batasToleransiMenit       Int      @default(15) @map("late_tolerance_minutes")
  hariKerja                 String   @default("Senin,Selasa,Rabu,Kamis,Jumat")
  tampilkanRekapKedisiplinan Boolean  @default(true)
  tampilkanPresensiHariIni  Boolean  @default(true)
  updatedAt                 DateTime @updatedAt

  @@map("system_settings")
}

model LogBook {
  id           Int      @id @default(autoincrement())
  userId       BigInt?  @map("user_id")
  tanggal      DateTime @db.Date
  waktuMulai   DateTime @map("waktu_mulai") @db.Time(0)
  waktuSelesai DateTime @map("waktu_selesai") @db.Time(0)
  kategori     String   @db.VarChar(50)
  aktivitas    String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("log_book")
}

