// Prisma Schema for SiPresma (MySQL Database)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPERADMIN
  ADMIN_MAGANG
  ADMIN_OS
  ANAK_MAGANG
  KARYAWAN_OS
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  HADIR
  IZIN
  SAKIT
  ALPA
}

enum StatusMasuk {
  TEPAT_WAKTU
  TERLAMBAT
}

enum StatusPulang {
  TEPAT_WAKTU
  PULANG_CEPAT
}

enum PendaftarStatus {
  pending
  lolos
  tidak_lolos
}

enum LeaveType {
  SAKIT
  KEPERLUAN_PRIBADI
  LAINNYA
}

enum LeaveStatus {
  Pending
  Disetujui
  Ditolak
}

enum JobdeskStatus {
  Belum_Mulai @map("Belum Mulai")
  Berjalan
  Selesai
}

model User {
  id             String         @id @default(uuid())
  username       String         @unique
  nama           String?
  name           String?
  email          String         @unique
  password       String         @default("admin123")
  no_hp          String?
  phone          String?
  role           Role           @default(ANAK_MAGANG)
  status         UserStatus     @default(ACTIVE)
  sekolah_kampus String?
  institution    String?
  unit_kerja     String?
  studyProgram   String?
  bagian         String?
  periode_mulai  String?
  periode_selesai String?
  startDate      String?
  endDate        String?
  identityNumber String?
  avatar         String?        @db.Text
  supervisor     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  leaveRequests  LeaveRequest[]

  @@map("users")
}

model Attendance {
  id                BigInt           @id @default(autoincrement())
  karyawanOsId      BigInt?          @map("karyawan_os_id")
  pesertaMagangId   BigInt?          @map("peserta_magang_id")
  pengaturanSistemId Int?            @map("pengaturan_sistem_id")
  tanggal           DateTime         @db.Date
  jamMasuk          DateTime?        @map("jam_masuk") @db.Time(0)
  jamKeluar         DateTime?        @map("jam_keluar") @db.Time(0)
  status            AttendanceStatus @default(HADIR)
  statusMasuk       StatusMasuk?     @map("status_masuk")
  statusPulang      StatusPulang?    @map("status_pulang")
  fotoMasuk         String?          @map("foto_masuk") @db.VarChar(500)
  fotoKeluar        String?          @map("foto_keluar") @db.VarChar(500)
  fotoPulangCepat   String?          @map("foto_pulang_cepat") @db.VarChar(500)
  keterangan        String?          @db.Text
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@map("absensi")
}

model LeaveRequest {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        LeaveType
  startDate   String
  endDate     String
  reason      String      @db.Text
  attachment  String?
  status      LeaveStatus @default(Pending)
  approvedBy  String?
  approvedAt  DateTime?
  adminNote   String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("leave_requests")
}

model Izin {
  id              BigInt   @id @default(autoincrement())
  absensi_id      BigInt?  @map("absensi_id")
  user_id         BigInt   @map("user_id")
  jenis           String   @db.VarChar(100)
  tanggal_mulai   DateTime @db.Date @map("tanggal_mulai")
  tanggal_selesai DateTime @db.Date @map("tanggal_selesai")
  alasan          String   @db.Text
  attachment      String?  @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("izin")
}

model Pendaftar {
  id              BigInt          @id @default(autoincrement())
  pengaturanId    Int?            @map("pengaturan_id")
  kodePendaftaran String          @unique @map("kode_pendaftaran") @db.VarChar(30)
  pesertaMagangId BigInt?         @map("peserta_magang_id")
  nama            String          @db.VarChar(150)
  email           String          @db.VarChar(150)
  noHp            String          @map("no_hp") @db.VarChar(20)
  sekolahKampus   String          @map("sekolah_kampus") @db.VarChar(200)
  studyProgram    String          @map("study_program") @db.VarChar(150)
  bagian          String          @db.VarChar(100)
  alamat          String          @db.Text
  periodeMulai    DateTime?       @map("periode_mulai") @db.Date
  periodeSelesai  DateTime?       @map("periode_selesai") @db.Date
  fileCv          String?         @map("file_cv") @db.VarChar(500)
  portfolioFile   String?         @map("portfolio_file") @db.VarChar(500)
  status          PendaftarStatus @default(pending)
  catatanAdmin    String?         @map("catatan_admin") @db.Text
  tanggalDaftar   DateTime        @default(now()) @map("tanggal_daftar")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@map("pendaftaran")
}

model Tugas {
  id              Int      @id @default(autoincrement())
  pesertaMagangId BigInt?  @map("peserta_magang_id")
  logBookId       Int?     @map("log_book_id")
  judulTugas      String   @map("judul_tugas") @db.VarChar(255)
  deskripsi       String   @db.Text
  kategori        String   @default("Umum") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("tugas")
}

model SystemSetting {
  id                        Int      @id @default(1)
  systemName                String   @default("SiPresma")
  timezone                  String   @default("Asia/Jakarta")
  jamMasukStandar           String   @default("07:30") @map("check_in_time")
  jamPulangStandar          String   @default("16:00") @map("check_out_time")
  jamPulangJumat            String   @default("14:00")
  batasToleransiMenit       Int      @default(15) @map("late_tolerance_minutes")
  hariKerja                 String   @default("Senin,Selasa,Rabu,Kamis,Jumat")
  tampilkanRekapKedisiplinan Boolean  @default(true)
  tampilkanPresensiHariIni  Boolean  @default(true)
  updatedAt                 DateTime @updatedAt

  @@map("system_settings")
}

model LogBook {
  id              Int      @id @default(autoincrement())
  pesertaMagangId BigInt?  @map("peserta_magang_id")
  tanggal         DateTime @db.Date
  waktuMulai      DateTime @map("waktu_mulai") @db.Time(0)
  waktuSelesai    DateTime @map("waktu_selesai") @db.Time(0)
  kategori        String   @db.VarChar(50)
  aktivitas       String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("log_book")
}

